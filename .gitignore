# --- Entrega original (o conteúdo já está extraído e versionado) ---
Timbrador*.zip

# --- Pacote original da página (timbrador.html e scripts) ---
# Referência local para o porte: traz razão social, CNPJ e logos reais.
/original/

# --- Saídas do gerador ---
# Documento gerado nunca entra no repositório: é produto, não fonte.
*.docx
*.pdf
/saida/
/out/

# --- Marca real de organização ---
# Só marca.exemplo.json e as marcas de teste são versionadas.
# Dado de empresa real (razão social, CNPJ) não volta para o código.
marca.json
skills/timbrador/assets/marca.json
# Ícone do site da organização (pagina/favicon.svg, favicon.png, apple-touch-icon.png)
pagina/favicon.*
pagina/apple-touch-icon.png
*_portatil.json
lista-mestra.json

# --- Python ---
__pycache__/
*.py[cod]

# --- Editor / SO ---
.vscode/
.idea/
*.swp
.DS_Store

# --- BMad Method (v7) ---
# .claude/skills/ (skills do BMad), skills-lock.json, _bmad/ e _bmad-output/ são versionados.
# Respostas pessoais (_bmad/custom/*.user.toml) e _bmad/render/ já têm .gitignore próprio.
.bmad-help-setup-modules*.toml
.v6-v7-migration-backup-*/
